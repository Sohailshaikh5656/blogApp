                    <div class="endpoint-card">
                        <div class="endpoint-header" @click="toggleEndpoint('blog-3')">
                            <div style="display: flex; align-items: center;">
                                <span class="endpoint-method method-get">GET</span>
                                <span>Get My Blogs</span>
                            </div>
                            <i class="material-icons">{{ isEndpointOpen['blog-3'] ? 'keyboard_arrow_up' : 'keyboard_arrow_down' }}</i>
                        </div>
                        <div id="blog-3" class="endpoint-body" :style="{display: isEndpointOpen['blog-3'] ? 'block' : 'none'}">
                            <p><strong>Endpoint:</strong> <%= globals.port_base_url %>api/user/myblogs</p>
                            <p><strong>Description:</strong> Retrieve blogs created by the authenticated user</p>
                            
                            <h4>Headers</h4>
                            <table class="param-table">
                                <tr>
                                    <th>Parameter</th>
                                    <th>Required</th>
                                    <th>Description</th>
                                </tr>
