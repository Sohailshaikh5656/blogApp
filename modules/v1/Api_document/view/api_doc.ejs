<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= globals.app_name %> Blog API Documentation</title>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700|Material+Icons" rel="stylesheet">
    <link href="https://unpkg.com/vuetify@1.0.17/dist/vuetify.min.css" rel="stylesheet">
    <link rel="shortcut icon" href="<%= globals.LOGO %>">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            padding: 0;
        }
        .header-banner {
            background: linear-gradient(135deg, #4a148c 0%, #6a1b9a 100%);
            color: white;
            padding: 20px 0;
            margin-bottom: 20px;
        }
        .api-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
        }
        .jwt-info {
            background-color: #fffbdd;
            border-left: 4px solid #ffc107;
            padding: 15px;
            margin: 20px 0;
            border-radius: 4px;
        }
        .server-info {
            background-color: #e8f5e9;
            border-radius: 4px;
            padding: 15px;
            margin-bottom: 20px;
        }
        .api-section {
            margin-bottom: 30px;
        }
        .section-title {
            color: #4a148c;
            border-bottom: 2px solid #4a148c;
            padding-bottom: 8px;
            margin-bottom: 15px;
        }
        .endpoint-card {
            margin-bottom: 15px;
            border-radius: 4px;
            overflow: hidden;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .endpoint-header {
            background-color: #f5f5f5;
            padding: 12px 15px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .endpoint-method {
            padding: 4px 8px;
            border-radius: 3px;
            color: white;
            font-weight: bold;
            font-size: 12px;
            margin-right: 10px;
            min-width: 60px;
            text-align: center;
        }
        .method-get { background-color: #4caf50; }
        .method-post { background-color: #2196f3; }
        .method-put { background-color: #ff9800; }
        .method-delete { background-color: #f44336; }
        .endpoint-body {
            padding: 15px;
            background-color: white;
            border-top: 1px solid #e0e0e0;
        }
        .param-table {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
        }
        .param-table th, .param-table td {
            border: 1px solid #e0e0e0;
            padding: 8px 12px;
            text-align: left;
        }
        .param-table th {
            background-color: #f5f5f5;
        }
        .code-block {
            background-color: #f5f5f5;
            padding: 10px;
            border-radius: 4px;
            font-family: 'Courier New', monospace;
            margin: 10px 0;
            overflow-x: auto;
            white-space: pre-wrap;
            font-size: 14px;
        }
        .nav-tabs {
            display: flex;
            border-bottom: 1px solid #e0e0e0;
            margin-bottom: 20px;
        }
        .nav-tab {
            padding: 10px 20px;
            cursor: pointer;
            border-bottom: 2px solid transparent;
        }
        .nav-tab.active {
            border-bottom: 2px solid #4a148c;
            color: #4a148c;
            font-weight: bold;
        }
        .tab-content {
            display: none;
        }
        .tab-content.active {
            display: block;
        }
        .quick-links {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 20px;
        }
        .quick-link {
            background-color: #4a148c;
            color: white;
            padding: 8px 15px;
            border-radius: 4px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .quick-link:hover {
            background-color: #6a1b9a;
        }
        .alert-box {
            padding: 10px;
            border-radius: 4px;
            margin: 10px 0;
        }
        .alert-mandatory {
            background-color: #e8f5e9;
            border-left: 4px solid #4caf50;
        }
        .alert-optional {
            background-color: #fff3e0;
            border-left: 4px solid #ff9800;
        }
        .alert-important {
            background-color: #ffebee;
            border-left: 4px solid #f44336;
        }
        .alert-notes {
            background-color: #e3f2fd;
            border-left: 4px solid #2196f3;
        }
        .response-example {
            background-color: #f9f9f9;
            border: 1px solid #e0e0e0;
            border-radius: 4px;
            padding: 15px;
            margin: 10px 0;
        }
        .response-title {
            font-weight: bold;
            color: #4a148c;
            margin-bottom: 5px;
        }
        .info-chip {
            display: inline-flex;
            align-items: center;
            background-color: #e3f2fd;
            color: #1565c0;
            padding: 4px 10px;
            border-radius: 16px;
            font-size: 12px;
            margin-right: 8px;
            margin-bottom: 8px;
        }
        .info-chip i {
            font-size: 14px;
            margin-right: 4px;
        }
    </style>
</head>
<body>
    <div id="app">
        <div class="header-banner">
            <div class="api-container">
                <h1 style="margin: 0; font-size: 28px;"><%= globals.app_name %> Blog API Documentation</h1>
                <p style="margin: 5px 0 0; opacity: 0.9;">Complete API reference for Blog Management System</p>
            </div>
        </div>

        <div class="api-container">
            <div class="server-info">
                <h3 style="margin-top: 0;">Server Information</h3>
                <p><strong>Base URL:</strong> <%= globals.port_base_url %></p>
                <p><strong>API Key:</strong> <%= globals.api_key %></p>
                <!-- <p><strong>Encryption IV:</strong> <%= globals.encryptionIV %></p> -->
            </div>

            <div class="jwt-info">
                <h3 style="margin-top: 0; color: #856404;">
                    <i class="material-icons" style="vertical-align: middle;">info</i>
                    JWT Token Instructions
                </h3>
                <p>After successful registration or login, you will receive a JWT token in the response. This token must be included in the <strong>Authorization</strong> header for all subsequent API requests that require authentication.</p>
                <div class="code-block">
    Headers: {
        "api_key":      "<%= globals.api_key %>",
        "token":        "Bearer jwt_token_received_from_login_or_register",
        "Content-Type": "application/json"
    }
                    </div>
                <p><strong>Note:</strong> Without a valid JWT token, you will receive "Invalid Token" or "Token Not Found" errors for protected endpoints.</p>
            </div>

            <div class="nav-tabs">
                <div class="nav-tab active" onclick="switchTab('auth')">Authentication</div>
                <div class="nav-tab" onclick="switchTab('blog')">Blog Management</div>
                <div class="nav-tab" onclick="switchTab('all')">All Endpoints</div>
            </div>

            <!-- Authentication APIs -->
            <div id="auth-tab" class="tab-content active">
                <div class="api-section">
                    <h2 class="section-title">Authentication Endpoints</h2>
                    
                    <div class="endpoint-card">
                        <div class="endpoint-header" @click="toggleEndpoint('auth-1')">
                            <div style="display: flex; align-items: center;">
                                <span class="endpoint-method method-post">POST</span>
                                <span>User Registration</span>
                            </div>
                            <i class="material-icons">{{ isEndpointOpen['auth-1'] ? 'keyboard_arrow_up' : 'keyboard_arrow_down' }}</i>
                        </div>
                        <div id="auth-1" class="endpoint-body" :style="{display: isEndpointOpen['auth-1'] ? 'block' : 'none'}">
                            <p><strong>Endpoint:</strong> <%= globals.port_base_url %>api/user/register</p>
                            <p><strong>Description:</strong> Register a new user account</p>
                            
                            <div class="alert-box alert-mandatory">
                                <strong>Request Body (JSON):</strong>
                                <div class="code-block">{
  "name": "John Doe",
  "email": "john@example.com",
  "password": "securePassword123"
}</div>
                            </div>
                            
                            <h4>Headers</h4>
                            <table class="param-table">
                                <tr>
                                    <th>Parameter</th>
                                    <th>Required</th>
                                    <th>Description</th>
                                </tr>
                                <tr>
                                    <td>api_key</td>
                                    <td>Yes</td>
                                    <td>API authentication key</td>
                                </tr>
                                <tr>
                                    <td>Content-Type</td>
                                    <td>Yes</td>
                                    <td>application/json</td>
                                </tr>
                            </table>
                            
                            <h4>Response Example (Success)</h4>
                            <div class="response-example">
                                <div class="response-title">HTTP 200 OK</div>
                                <div class="code-block">{
    "code": "1",
    "message": "user_registered",
    "data": {
        "id": 3,
        "name": "Sohail Shaikh",
        "email": "sohailshaikh121@gmail.com",
        "isActive": true,
        "isDeleted": false,
        "createdAt": "2025-12-06T09:09:16.599Z",
        "updatedAt": "2025-12-06T09:09:16.599Z",
        "jwtToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjMsImlhdCI6MTc2NTAxMjE1NiwiZXhwIjoxNzY1MDk4NTU2fQ.fh7B_qkmqS64FqoA3F10iateXs6M0BYQVaniutAit30"
    }
}</div>
                            </div>
                            
                            <h4>Response Status</h4>
                            <ul>
                                <li><strong>HTTP 200</strong> - code: 1 - User registered successfully</li>
                                <li><strong>HTTP 200</strong> - code: 0 - Registration failed</li>
                                <li><strong>HTTP 400</strong> - Bad Request (missing parameters)</li>
                                <li><strong>HTTP 409</strong> - Conflict (email already exists)</li>
                            </ul>
                        </div>
                    </div>
                    
                    <div class="endpoint-card">
                        <div class="endpoint-header" @click="toggleEndpoint('auth-2')">
                            <div style="display: flex; align-items: center;">
                                <span class="endpoint-method method-post">POST</span>
                                <span>User Login</span>
                            </div>
                            <i class="material-icons">{{ isEndpointOpen['auth-2'] ? 'keyboard_arrow_up' : 'keyboard_arrow_down' }}</i>
                        </div>
                        <div id="auth-2" class="endpoint-body" :style="{display: isEndpointOpen['auth-2'] ? 'block' : 'none'}">
                            <p><strong>Endpoint:</strong> <%= globals.port_base_url %>api/user/login</p>
                            <p><strong>Description:</strong> Authenticate user and receive JWT token</p>
                            
                            <div class="alert-box alert-mandatory">
                                <strong>Request Body (JSON):</strong>
                                <div class="code-block">{
  "email": "john@example.com",
  "password": "securePassword123"
}</div>
                            </div>
                            
                            <h4>Headers</h4>
                            <table class="param-table">
                                <tr>
                                    <th>Parameter</th>
                                    <th>Required</th>
                                    <th>Description</th>
                                </tr>
                                <tr>
                                    <td>api_key</td>
                                    <td>Yes</td>
                                    <td>API authentication key</td>
                                </tr>
                                <tr>
                                    <td>Content-Type</td>
                                    <td>Yes</td>
                                    <td>application/json</td>
                                </tr>
                            </table>
                            
                            <h4>Response Example (Success)</h4>
                            <div class="response-example">
                                <div class="response-title">HTTP 200 OK</div>
                                <div class="code-block">{
    "code": "1",
    "message": "login_successful",
    "data": {
        "id": 1,
        "name": "rehan shaikh",
        "email": "rehanshaikh12@gmail.com",
        "isActive": true,
        "isDeleted": false,
        "createdAt": "2025-12-05T17:59:25.678Z",
        "updatedAt": "2025-12-05T17:59:25.678Z",
        "JWTToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjEsImlhdCI6MTc2NTAxMjI1MSwiZXhwIjoxNzY1MDk4NjUxfQ.WL4Sd54D7RPSFmYaq9WPOj-3toRqxAGgpjiJAcodKc8"
    }
}</div>
                            </div>
                            
                            <h4>Response Status</h4>
                            <ul>
                                <li><strong>HTTP 200</strong> - code: 1 - Login successful</li>
                                <li><strong>HTTP 200</strong> - code: 0 - Invalid credentials</li>
                                <li><strong>HTTP 400</strong> - Bad Request (missing parameters)</li>
                                <li><strong>HTTP 404</strong> - User not found</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Blog Management APIs -->
            <div id="blog-tab" class="tab-content">
                <div class="api-section">
                    <h2 class="section-title">Blog Management Endpoints</h2>
                    
                    <div class="endpoint-card">
