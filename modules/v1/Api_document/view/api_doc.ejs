                            <div class="alert-box alert-optional">
                                <strong>Optional Parameters:</strong> tags, summary
                            </div>
                            
                            <h4>Headers</h4>
                            <table class="param-table">
                                <tr>
                                    <th>Parameter</th>
                                    <th>Required</th>
                                    <th>Description</th>
                                </tr>
                                <tr>
                                    <td>api_key</td>
